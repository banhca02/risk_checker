# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
#   Copy-Item .env.example .env
# .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# SQLAlchemy 2.x resolves postgresql:// to the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/import_doc_audit

# Gemini API key, consumed through the OpenAI-compatible endpoint.
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for document classification and structured extraction.
GEMINI_MODEL=gemini-3.1-flash-lite

# Where uploaded documents are written to disk.
STORAGE_DIR=./storage

# OCR fallback for scanned pages. Keep false unless you installed the
# Tesseract OS executable (pytesseract alone is not enough).
ENABLE_OCR_FALLBACK=false
